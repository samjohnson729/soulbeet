# Template for services/soulbeet/.env — copy to .env and fill in real values.
# `.env` is gitignored; this template is tracked so the required keys are known.

# Encrypts the slskd API key and scrobble credentials Soulbeet stores in its
# database. Generate with: openssl rand -hex 32
#
# Rotating this invalidates those stored credentials: you will re-enter the
# slskd URL + API key under Settings > Config, and any Last.fm / ListenBrainz
# tokens under Settings > Library. It does not touch the music library.
SOULBEET_SECRET_KEY=
